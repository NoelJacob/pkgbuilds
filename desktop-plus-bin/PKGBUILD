_pkgname='desktop-plus'
pkgname="${_pkgname}-bin"
pkgver=3.6.6.1
pkgrel=2
pkgdesc="GitHub Desktop fork with extra features and improvements (binary release)."
arch=('x86_64')
url="https://github.com/desktop-plus/desktop-plus"
license=('MIT')
provides=(${_pkgname})
conflicts=(${_pkgname})
depends=(
    'electron'
    'curl'
    'git'
    'libnotify'
    'libsecret'
    'libxss'
    'nspr'
    'nss'
    'org.freedesktop.secrets'
    'unzip'
)
optdepends=('hub: CLI interface for GitHub.')
source=(
    "${_pkgname}.desktop"
    'launch-app.sh'
)

_common_download_url="${url}/releases/download/v${pkgver}/DesktopPlus-v${pkgver}-linux"
source_x86_64=(${_common_download_url}-x86_64.deb)

sha256sums=(
    'a49191aebdf7c21d7605778e94d1490fcde9af0cb695aaf0d7f30e1214fe0c6c'
    '4c239825620fed5133724093700d295f15e5c8f052a83267ecb760b989714565'
)
sha256sums_x86_64=('832101eefb59f53b182bfed09b7b801748124f209971a489aaf1ae09915c2171')
package() {
    # Extract the .deb payload outside $pkgdir; copy only the app code in.
    # App dir: usr/lib/desktop-plus/resources/app (main: ./main.js).
    rm -rf "$srcdir/deb"
    mkdir -p "$srcdir/deb"
    tar --zstd -xf data.tar.zst -C "$srcdir/deb"

    install -d "$pkgdir/usr/lib/${_pkgname}"
    cp -a "$srcdir/deb/usr/lib/desktop-plus/resources/app" "$pkgdir/usr/lib/${_pkgname}/"

    install -Dm644 "${_pkgname}.desktop" "$pkgdir/usr/share/applications/${_pkgname}.desktop"
    install -Dm755 "$srcdir/launch-app.sh" "$pkgdir/usr/bin/${_pkgname}"
    install -Dm644 "$srcdir/deb/usr/share/doc/desktop-plus/copyright" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
